# Copy to .env (git-ignored), fill in what you actually use, then load it:
#   set -a; . ./.env; set +a
# The bot reads REAL environment variables only - it has no dotenv parser and
# no third-party packages. Never commit .env. Never put a seed phrase anywhere.

# ---- optional: FOMO flow data (independent service, NOT fomo.family) --------
# fomoapi.io is an unofficial third-party API. FOMO Labs publishes no public
# API. Free key: 20 requests/minute, 250,000 credits/month, 250 credits/call.
FOMO_API_KEY=

# ---- optional: Telegram alerts ----------------------------------------------
# Create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- optional: better price/safety coverage --------------------------------
# CoinGecko demo key for /coins/list/new (otherwise GeckoTerminal fallback).
# CG_API_KEY is passed with --cg-key, not read from the environment.
CG_API_KEY=

# ---- optional: LIVE mode only (never needed for signals/paper) --------------
# A dedicated BURNER wallet. Base58 secret key. Do not use your FOMO wallet.
# SOLANA_PRIVATE_KEY=
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# JUPITER_API_KEY=

# ---- optional: web research via Obscura headless browser -------------------
# OBSCURA_BIN=/data/data/com.termux/files/home/bin/obscura
# OBSCURA_STORAGE_DIR=/data/data/com.termux/files/home/.obscura-cookies
